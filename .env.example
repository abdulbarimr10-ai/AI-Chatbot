# ==============================================================================
# Environment Configuration Template for LangGraph AI Chatbot + MCP + RAG
# ==============================================================================
# Copy this file to .env (or backend/.env) and configure your credentials.

# --- LLM Provider Credentials ---
# Option 1: OpenAI API Key (Default for ChatOpenAI & OpenAIEmbeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Hugging Face Token (Alternative LLM provider for ChatHuggingFace)
HF_TOKEN=your_huggingface_token_here
# HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# HF_PROVIDER=featherless-ai

# --- External Tool APIs ---
# Alpha Vantage API Key (Required for get_stock_price tool)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# --- Model Context Protocol (MCP) Configuration ---
# Math MCP Server (Runs locally via stdio by default)
MCP_MATH_SERVER_ENABLED=true
# MCP_MATH_SERVER_PATH=backend/mcp_math_server.py
# MCP_MATH_SERVER_COMMAND=python

# Expense MCP Server (Runs locally via stdio by default)
MCP_EXPENSE_SERVER_ENABLED=true
# MCP_EXPENSE_SERVER_PATH=backend/mcp_expense_server.py
# MCP_EXPENSE_SERVER_COMMAND=python
# MCP_EXPENSE_SERVER_URL= (optional remote server URL)
# MCP_EXPENSE_SERVER_TRANSPORT=streamable_http

# --- Persistent PDF RAG Configuration ---
RAG_STORAGE_DIR=./data/rag
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_MAX_FILE_SIZE=26214400

# --- SQLite Database Checkpointer Path ---
# CHATBOT_DB_PATH=chatbot.db

# --- Optional LangSmith Tracing ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=Chatbot-LangGraph
