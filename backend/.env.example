# ==============================================================================
# Environment Configuration Template for LangGraph FastAPI Backend + MCP + RAG
# ==============================================================================
# Copy this file to .env and replace placeholder values with your actual credentials.

# Option 1: OpenAI API Key (Default for ChatOpenAI & OpenAIEmbeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Hugging Face Token (Alternative LLM provider)
HF_TOKEN=your_huggingface_token_here
# HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# HF_PROVIDER=featherless-ai

# Alpha Vantage API Key (Required for get_stock_price tool)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Optional: Model Context Protocol (MCP) Configuration
MCP_MATH_SERVER_ENABLED=true
# MCP_MATH_SERVER_PATH=backend/mcp_math_server.py
# MCP_MATH_SERVER_COMMAND=python

MCP_EXPENSE_SERVER_ENABLED=true
# MCP_EXPENSE_SERVER_PATH=backend/mcp_expense_server.py
# MCP_EXPENSE_SERVER_COMMAND=python
# MCP_EXPENSE_SERVER_URL= (optional remote server URL)
# MCP_EXPENSE_SERVER_TRANSPORT=streamable_http

# Optional: Persistent PDF RAG Configuration
RAG_STORAGE_DIR=./data/rag
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_MAX_FILE_SIZE=26214400

# Optional: SQLite Database path (Defaults to chatbot.db in project root)
# CHATBOT_DB_PATH=chatbot.db
